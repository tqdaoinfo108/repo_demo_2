# Optional public URL of a server-side proxy that holds AI_TOKEN and calls OpenRouter.
NEXT_PUBLIC_AI_PROXY_URL=https://htx-so-openrouter-proxy.<your-cloudflare-subdomain>.workers.dev

# Direct mode only: this value is embedded in the published JavaScript.
# It is intentionally not set locally. Prefer the proxy configuration above.
NEXT_PUBLIC_AI_TOKEN=

# Public URL of the HTX MongoDB API. GitHub Pages reads this at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
