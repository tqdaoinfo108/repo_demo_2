# MongoDB Atlas — use the complete URI only. Do not wrap it in quotes,
# do not prefix it with MONGODB_URI= inside the value, and do not leave
# <db_password> in place.
MONGODB_URI=mongodb+srv://<username>:<url_encoded_password>@<cluster>.mongodb.net/htx_so?retryWrites=true&w=majority&appName=HTX
MONGODB_DATABASE=htx_so

# API local runtime. Render supplies PORT automatically; do not set PORT there.
API_PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Required in hosted environments. Generate a long random secret; never publish it.
JWT_SECRET=replace_with_a_long_random_secret

# Used only by `npm run db:seed` to create/reset demo user passwords.
DEMO_ADMIN_PASSWORD=replace_with_a_strong_demo_password

# Next.js public build variables. These are embedded into the static frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000
